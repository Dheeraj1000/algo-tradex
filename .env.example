# ============================================
# AlgoTradeX Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ---- Application ----
APP_NAME=AlgoTradeX
APP_ENV=development
APP_DEBUG=true

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=algotradex
POSTGRES_USER=algotradex
POSTGRES_PASSWORD=change_me_in_production

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Backend (Spring Boot) ----
BACKEND_PORT=8080
JWT_SECRET=your-256-bit-secret-key-change-in-production-minimum-32-chars
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Frontend ----
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=ws://localhost:8080/ws
VITE_AI_API_BASE_URL=http://localhost:8000/ai

# ---- AI Service (FastAPI) ----
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=ai-service
MODEL_STORAGE_PATH=/app/models

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@algotradex.com

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DEFAULT_CHAT_ID=

# ---- Broker APIs ----
# Angel One SmartAPI
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8080/api/broker/upstox/callback

# Shoonya (Finvasia)
SHOONYA_API_KEY=
SHOONYA_VENDOR_CODE=
SHOONYA_IMEI=

# Dhan
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Zerodha Kite Connect
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Groww
GROWW_API_KEY=
GROWW_API_SECRET=

# ---- Encryption ----
ENCRYPTION_KEY=32-byte-encryption-key-change-me!
ENCRYPTION_ALGORITHM=AES/GCM/NoPadding

# ---- Monitoring ----
ENABLE_METRICS=true
LOG_LEVEL=INFO
